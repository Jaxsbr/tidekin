    "islands:check": "node scripts/island-lab/check-evidence.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@playwright/test": "^1.55.0"
  }
